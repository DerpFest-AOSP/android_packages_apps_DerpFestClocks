//
// Open-source SystemUI lockscreen clock plugins. Each apk is a ClockProviderPlugin
// (discovered via com.android.systemui.action.PLUGIN_CLOCK_PROVIDER). The rendering
// engine (org.derpfest.clocks, engine/) is built on the AOSP plugin API
// (SystemUIPluginLib) and clock helpers (SystemUIClocks-CommonLib).
//
// Plugins are platform-signed so they share SystemUI's signature and are granted the
// signature-level com.android.systemui.permission.PLUGIN the plugin loader requires.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Shared engine (no artwork), linked into each clock apk.
android_library {
    name: "DerpFestClocksEngine",
    manifest: "engine/AndroidManifest.xml",
    srcs: ["engine/src/**/*.kt"],
    resource_dirs: ["engine/res"],
    use_resource_processor: true,
    libs: ["SystemUIPluginLib"],
    static_libs: [
        "SystemUIClocks-CommonLib",
        "PlatformAnimationLib",
        "PlatformComposeSceneTransitionLayout",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation-layout",
        "androidx-constraintlayout_constraintlayout",
        "androidx.core_core",
        "gson",
        "monet",
    ],
    kotlincflags: ["-Xjvm-default=all"],
    min_sdk_version: "current",
    platform_apis: true,
    system_ext_specific: true,
}

java_defaults {
    name: "DerpFestClocksAppDefaults",
    use_resource_processor: true,
    libs: ["SystemUIPluginLib"],
    static_libs: ["DerpFestClocksEngine"],
    kotlincflags: ["-Xjvm-default=all"],
    min_sdk_version: "current",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    certificate: "platform",
    // Do not shrink. R8 cannot see SystemUI reading ClockFaceLayout.elements / getKey()
    // across the plugin classloader and will stub getKey() to null, which hides the
    // face when scene_container is on.
    optimize: {
        enabled: false,
    },
}

// The time spelled out ("It's / Five / Sixteen"), top-start of the lockscreen.
android_app {
    name: "DerpFestClocks-Words",
    defaults: ["DerpFestClocksAppDefaults"],
    manifest: "clocks/words/AndroidManifest.xml",
    srcs: ["clocks/words/src/**/*.kt"],
    resource_dirs: ["clocks/words/res"],
    asset_dirs: ["clocks/words/assets"],
    // The face layout is composable; a direct compose dependency turns the compiler plugin on.
    static_libs: [
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation-layout",
        "PlatformComposeSceneTransitionLayout",
    ],
}
